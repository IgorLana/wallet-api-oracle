      "versionNonce": 1312110049,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795009374685,
      "created": 1795009374685,
      "link": null,
      "locked": false,
      "text": "Mesmo key=a, mas valor / tipo / wallet diferente\n→ ORA-20005 → HTTP 409.\nUNIQUE global no banco impede dupla gravação\nmesmo entre carteiras diferentes.",
      "originalText": "Mesmo key=a, mas valor / tipo / wallet diferente\n→ ORA-20005 → HTTP 409.\nUNIQUE global no banco impede dupla gravação\nmesmo entre carteiras diferentes.",
