      "isDeleted": false,
      "boundElements": null,
      "updated": 1795009374685,
      "created": 1795009374685,
      "link": null,
      "locked": false,
      "text": "Obtém lock de WALLET #42\nVê saldo R$ 50\nINSERT txn + UPDATE → R$ 20\nCOMMIT, libera lock",
      "originalText": "Obtém lock de WALLET #42\nVê saldo R$ 50\nINSERT txn + UPDATE → R$ 20\nCOMMIT, libera lock",
