    },
    {
      "id": "wallet-text-00195",
      "type": "text",
      "x": 199,
      "y": 4288,
      "width": 2570,
      "height": 39.0,
      "angle": 0,
      "strokeColor": "#2563EB",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
