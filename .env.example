# LOCAL DEMONSTRATION ONLY. These values are PUBLIC, not production secrets.
# Docker quick start: docker compose up --build (no .env required).
# Optional: copy this to .env to customize credentials before the FIRST startup.
# Never deploy these credentials, publish your actual .env, or reuse them elsewhere.

# Oracle Free SYS password (demo-only)
ORACLE_PASSWORD=OracleLocalDev2026

# Distinct demo-only schema passwords (12-64 chars, start with a letter)
WALLET_OWNER_PASSWORD=WalletOwnerDev2026
WALLET_APP_PASSWORD=WalletAppDev2026
WALLET_AUDIT_PASSWORD=WalletAuditDev2026

# Demo-only API key (at least 16 characters)
WALLET_API_KEY=WalletApiDemoKey2026

# Used only when running Spring Boot directly on the host (legacy development mode)
SERVER_PORT=8080
DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
